# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Personal job-search material — this repo is PUBLIC.
# Resumes, cover letters, application queues, screening answers, and company
# intel live here and stay local. Untracked 2026-08-05; earlier commits still
# contain them, so treat anything added before that date as already published.
# Already excluded from deploys via .vercelignore.
documents/

# Claude Code / Superpowers local state
.superpowers/

# Supabase CLI local temp
supabase/.temp/

# Marks the last successful materials sync so the hook can skip the work when
# nothing under documents/ has changed. Local timing state, not shared config.
.claude/.materials-sync-stamp
