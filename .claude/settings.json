  {
    "permissions": {
      "allow": [
        "mcp__claude-in-chrome__computer",
        "mcp__claude-in-chrome__browser_batch",
        "mcp__claude-in-chrome__javascript_tool",
        "mcp__claude-in-chrome__navigate",
        "mcp__claude-in-chrome__form_input",
        "mcp__claude-in-chrome__find",
        "mcp__claude-in-chrome__read_page",
        "mcp__claude-in-chrome__get_page_text",
        "mcp__claude-in-chrome__tabs_context_mcp",
        "mcp__claude-in-chrome__tabs_create_mcp",
        "mcp__claude-in-chrome__file_upload",
        "Bash(.claude/skills/one-application-per-company/apply-guard.ts *)",
        "mcp__claude_ai_Notion__notion-fetch",
        "mcp__claude_ai_Notion__notion-search",
        "mcp__claude_ai_Notion__notion-query-data-sources",
        "mcp__claude_ai_Google_Calendar__list_events",
        "mcp__claude_ai_Gmail__search_threads",
        "mcp__claude_ai_Fireflies__fireflies_search",
        "mcp__claude_ai_Fireflies__fireflies_get_transcript",
        "mcp__supabase__list_tables",
        "mcp__supabase__get_project_url",
        "mcp__supabase__query_logs"
      ]
    },
    "hooks": {
      "PostToolUse": [
        {
          "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
          "hooks": [
            {
              "type": "command",
              "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sync-materials.sh",
              "timeout": 60,
              "statusMessage": "Syncing materials…"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sync-materials.sh",
              "timeout": 60,
              "statusMessage": "Syncing materials…"
            }
          ]
        }
      ]
    }
  }
